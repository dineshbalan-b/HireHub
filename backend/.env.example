# =======================================================
# Backend Environment Configuration Example
# Copy this file to .env and replace with your credentials
# =======================================================

# Nexus / OpenAI LLM Configuration
NEXUS_API_BASE_URL=https://api.openai.com/v1
NEXUS_API_KEY=your_api_key_here

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_change_me_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database & Vector Store Settings
DATABASE_URL=sqlite+aiosqlite:///./data/agenthire.db
CHROMA_PERSIST_DIR=./data/chroma_store
